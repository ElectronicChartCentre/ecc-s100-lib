{
  "name": "@ecc/s100-viewer",
  "version": "0.1.0-alpha.10",
  "private": false,
  "type": "module",
  "description": "Engine-neutral S-100 viewer API with product layer specs and builders.",
  "keywords": [
    "s-100",
    "s-101",
    "s-102",
    "s-104",
    "s-111",
    "geospatial",
    "maritime",
    "3d-tiles",
    "viewer"
  ],
  "sideEffects": false,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ElectronicChartCentre/ecc-s100-lib.git",
    "directory": "packages/s100-viewer"
  },
  "bugs": {
    "url": "https://github.com/ElectronicChartCentre/ecc-s100-lib/issues"
  },
  "homepage": "https://github.com/ElectronicChartCentre/ecc-s100-lib/tree/main/packages/s100-viewer#readme",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./math": {
      "types": "./dist/math.d.ts",
      "import": "./dist/math.js"
    },
    "./features": {
      "types": "./dist/entrypoints/features.d.ts",
      "import": "./dist/entrypoints/features.js"
    },
    "./products": {
      "types": "./dist/entrypoints/products.d.ts",
      "import": "./dist/entrypoints/products.js"
    },
    "./products/enc": {
      "types": "./dist/entrypoints/products/enc.d.ts",
      "import": "./dist/entrypoints/products/enc.js"
    },
    "./products/route": {
      "types": "./dist/entrypoints/products/route.d.ts",
      "import": "./dist/entrypoints/products/route.js"
    },
    "./products/s102": {
      "types": "./dist/entrypoints/products/s102.d.ts",
      "import": "./dist/entrypoints/products/s102.js"
    },
    "./products/s111": {
      "types": "./dist/entrypoints/products/s111.d.ts",
      "import": "./dist/entrypoints/products/s111.js"
    },
    "./products/simulated-water-level": {
      "types": "./dist/entrypoints/products/simulated-water-level.d.ts",
      "import": "./dist/entrypoints/products/simulated-water-level.js"
    },
    "./products/vessel": {
      "types": "./dist/entrypoints/products/vessel.d.ts",
      "import": "./dist/entrypoints/products/vessel.js"
    },
    "./internal/*": {
      "types": "./dist/internal/*.d.ts",
      "import": "./dist/internal/*.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "check": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "clean": "rm -rf dist coverage"
  },
  "dependencies": {
    "proj4": "^2.20.8"
  },
  "license": "MIT"
}
