{
  "name": "@ecc/s100-viewer-products",
  "version": "0.1.0-alpha.0",
  "private": false,
  "type": "module",
  "description": "Deprecated facade for S-100 product helpers now exported by @ecc/s100-viewer.",
  "keywords": [
    "s-100",
    "s-101",
    "s-102",
    "s-104",
    "s-111",
    "geospatial"
  ],
