# RTZ Route Demo local configuration template.
#
# Copy this file to `.env.local` and fill in local service values when you
# want S-102 bathymetry under the route-volume visualization. `.env.local` is
# intentionally git-ignored. Do not commit API keys or private dataset IDs.

# Route projection and scene-local origin. Defaults are for the bundled Bergen
# sample route. Override these when loading RTZ files over a different S-102
# dataset so route geometry and 3D Tiles share the same projected CRS.
VITE_RTZ_ROUTE_CRS=EPSG:32632
VITE_RTZ_ROUTE_ORIGIN_LON=5.29
VITE_RTZ_ROUTE_ORIGIN_LAT=60.42
VITE_RTZ_ROUTE_ORIGIN_Z=0
# Optional projected origin override. If omitted, the demo projects the
# longitude/latitude origin into VITE_RTZ_ROUTE_CRS.
# The demo also recognizes VITE_DEMO_CRS/VITE_DEMO_ORIGIN_* and
# VITE_REFERENCE_CRS/VITE_REFERENCE_ORIGIN_* as fallbacks when reusing local
# service config from the other examples.
# VITE_RTZ_ROUTE_ORIGIN_X=
# VITE_RTZ_ROUTE_ORIGIN_Y=

# PRIMAR S-102 3D Tiles input. Dataset IDs are comma-separated.
# The demo also recognizes the existing VITE_DEMO_* and VITE_REFERENCE_*
# S-102 variables used by the other examples.
VITE_RTZ_ROUTE_S102_API_KEY=
VITE_RTZ_ROUTE_S102_3D_TILES_ENDPOINT=https://example.invalid/3dtiles_apikey/
VITE_RTZ_ROUTE_S102_DATASET_IDS=

# Optional terrain portrayal tuning.
VITE_RTZ_ROUTE_S102_SAFETY_DEPTH_METERS=12
VITE_RTZ_ROUTE_S102_DETAIL_FACTOR=500
