# Copy this file to .env.local and fill in local credentials/dataset ids.
# The service variable names mirror S-100 Explorer where possible.

# Key used by the S-102 3D Tiles endpoint. S-100 Explorer currently names this
# VITE_S111_PRIMAR_API_KEY even when it is also used for S-102.
VITE_S111_PRIMAR_API_KEY=

# Licensee key used by S-101 WMS and S-111 service requests.
VITE_DEMO_LICENSEE_KEY=

# Service endpoints. Use the same service family as S-100 Explorer.
VITE_S102_PRIMAR_3D_TILES_ENDPOINT=https://example.invalid/3dtiles_apikey/
VITE_S111_PRIMAR_ENDPOINT=https://example.invalid/api/rest/s100-json-web-service/s111/
VITE_PRIMAR_WMS_URL_BASE=https://example.invalid/wms_ip/anonymous

# Optional S-101 WMS portrayal styles. PRIMAR S-101 capabilities currently
# expose `transparentLand` for overlay-style use and `default` for basemaps.
VITE_DEMO_S101_WMS_STYLE_ID=transparentLand
VITE_DEMO_S101_WMS_BASEMAP_STYLE_ID=default

# Dataset ids should come from a scenario or product catalogue selection.
VITE_DEMO_S102_DATASET_IDS=
VITE_DEMO_S111_DATASET_IDS=

# Scene-local projected coordinate system and origin.
VITE_DEMO_CRS=EPSG:32619
VITE_DEMO_ORIGIN_X=0
VITE_DEMO_ORIGIN_Y=0
VITE_DEMO_ORIGIN_Z=0
VITE_DEMO_MAP_WIDTH_METERS=5000
VITE_DEMO_S101_WMS_LAYERS=s100dataSets.101

# Optional Live AIS proxy endpoint. Start the backend from the super repo at
# services/ecc-ais-proxy-instance with npm run dev. Do not put BarentsWatch
# BW_CLIENT_ID or BW_AIS_CLIENT_SECRET in this frontend file.
VITE_AIS_PROXY_URL=http://localhost:8787
VITE_AIS_REFRESH_INTERVAL_MS=30000
VITE_AIS_MAX_VESSELS=250
VITE_AIS_MAX_AGE_SECONDS=300

# S-102 datasets used by the Live AIS Norway scene. These default to the
# Stavanger scenario datasets when omitted, but can be overridden locally.
VITE_DEMO_LIVE_AIS_S102_DATASET_IDS=102NO006J0811_10_U,102NO006T0711_40_U,102NO006T0711_30_U,102NO006J0811_20_U

# Keep the Live AIS scene terrain-first by default. Enable this only when the
# local S-101 WMS style is known to return usable non-opaque imagery for
# Stavanger.
VITE_DEMO_LIVE_AIS_S101_ENABLED=false
