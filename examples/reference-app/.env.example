# S-100 Reference App local configuration template.
#
# Copy this file to `.env.local` and fill in service-specific values.
# `.env.local` is intentionally git-ignored. Do not commit licensee keys,
# API keys, scenario-specific dataset ids, or private endpoints.
#
# The reference app demonstrates which values a consuming application owns:
# scene placement, service endpoints, credentials, selected product datasets,
# and optional demo vessel placement. The feature sessions own reusable product
# orchestration once these inputs are provided.

# Projected-local scene CRS and origin. Use values near your datasets so the
# engine can render service-backed products in a numerically stable local scene.
VITE_REFERENCE_CRS=EPSG:32619
VITE_REFERENCE_ORIGIN_X=331100
VITE_REFERENCE_ORIGIN_Y=5186420
VITE_REFERENCE_ORIGIN_Z=0
VITE_REFERENCE_MAP_WIDTH_METERS=5000

# Lat/lon bounds used for ENC availability checks and as fallback S-111 bounds.
# Replace these with the scenario or viewport bounds used by your application.
VITE_REFERENCE_BOUNDS_NORTH=46.85
VITE_REFERENCE_BOUNDS_EAST=-70.95
VITE_REFERENCE_BOUNDS_SOUTH=46.75
VITE_REFERENCE_BOUNDS_WEST=-71.08

# Licensee key used for S-111 and ENC requests.
VITE_REFERENCE_LICENSEE_KEY=

# S-102 3D Tiles service input. The API key is passed to
# `PrimarServices.s102Tiles(...)`; dataset IDs are comma-separated.
VITE_REFERENCE_S102_API_KEY=
VITE_REFERENCE_S102_3D_TILES_ENDPOINT=
VITE_REFERENCE_S102_DATASET_IDS=

# S-111 service input. Dataset IDs are comma-separated and are mapped to
# `S111WorkflowDataset` records by the reference app.
VITE_REFERENCE_S111_ENDPOINT=
VITE_REFERENCE_S111_DATASET_IDS=

# ENC WMS input. `VITE_REFERENCE_ENC_WMS_BASE_URL` is the WMS origin/base URL.
# `VITE_REFERENCE_S57_WMS_TEMPLATE_PATH` is the S-57 URL template path used by
# `PrimarServices.s57EncWms(...)`; in S-100 Explorer this corresponds to
# `VITE_PRIMAR_WMS_URL_PATH`.
VITE_REFERENCE_ENC_WMS_BASE_URL=
VITE_REFERENCE_S57_WMS_TEMPLATE_PATH=

# Optional. Defaults to the shared demo vessel asset served by this example.
VITE_REFERENCE_VESSEL_MODEL_URL=
VITE_REFERENCE_VESSEL_HEADING_DEGREES=35
